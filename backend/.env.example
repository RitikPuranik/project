# Orbin Backend Environment Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/orbin
JWT_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Google sign-in (optional): OAuth "Web application" client from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed under "Authorized redirect URIs" in the Google client
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email via EmailJS (OTP codes, forgot password, welcome and notification emails)
# EmailJS dashboard -> Email Services (service id), Email Templates (template id), Account -> API keys
# Also enable "Allow EmailJS API for non-browser applications" under Account -> Security.
# The template must use: Subject {{subject}}, To Email {{to_email}}, From Name {{from_name}}, Content {{{html_body}}}
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Shown as the sender name and in email headers (optional)
EMAIL_FROM_NAME=Orbin
